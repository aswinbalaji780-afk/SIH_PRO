# ==========================================================
# AI-Enabled Skill Intelligence & Learning Platform (.env)
# ==========================================================

APP_NAME="National Skill Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration
# Uses SQLite for zero-config local run, seamlessly switchable to PostgreSQL
DATABASE_URL="sqlite:///./skill_intelligence.db"

# JWT Authentication & RBAC
JWT_SECRET="mospi-secret-key-capacity-building-2026-production-ready"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# External Integrations (Toggle MOCK vs LIVE)
MOCK_IGOT=True
IGOT_API_BASE_URL="https://api.igot-karmayogi.gov.in/v1"
IGOT_CLIENT_ID="igot_mock_client_id"
IGOT_CLIENT_SECRET="igot_mock_client_secret"
IGOT_AUTH_URL="https://auth.igot-karmayogi.gov.in/oauth2/token"

MOCK_NSSTA=True
NSSTA_API_BASE_URL="https://api.nssta.gov.in/tpac/v1"

# AI Provider Configuration
AI_PROVIDER="mock_ai_grounded"
LLM_MODEL="gemini-1.5-pro"
LLM_API_KEY="optional_placeholder"

# Storage Settings
STORAGE_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# Recommendation & Skill Gap Thresholds
SKILL_GAP_CRITICAL_THRESHOLD=51
SKILL_GAP_HIGH_THRESHOLD=31
SKILL_GAP_MEDIUM_THRESHOLD=16
SKILL_GAP_LOW_THRESHOLD=6
